# TalentFlow ATS — Backend Environment Configuration Example
# Copy this file to backend/.env and populate with your credentials

# Database Configuration (PostgreSQL in production; SQLite fallback for local testing)
DATABASE_URL=postgresql://user:password@localhost:5432/talentflow

# Security & JWT Authentication
JWT_SECRET=replace_with_strong_production_jwt_secret
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
FLASK_SECRET_KEY=replace_with_strong_flask_session_key

# CORS Allowed Frontend Origins (comma-separated)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://ats917.vercel.app

# Production AI & HuggingFace (for embedding / RAG models)
HF_TOKEN=your_huggingface_api_token_here

# Server Deployment & Port
PORT=5000
FLASK_ENV=production
GUNICORN_TIMEOUT=120
WEB_CONCURRENCY=1

# Email Notification Delivery (SMTP / Gmail)
EMAIL_PROVIDER=mock
EMAIL_SENDER=recruiting@talentflow.ai
EMAIL_PASSWORD=your_app_specific_password
