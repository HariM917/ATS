# FlowATS Backend Environment Variables
# Copy this file to .env and fill in your values

# HuggingFace API Token (Required for AI features)
HF_TOKEN=your_huggingface_api_token_here

# Server Port
PORT=5000

# Flask Environment
FLASK_ENV=production

# Flask Secret Key (auto-generated if not set)
# FLASK_SECRET_KEY=your_secret_key_here

# Frontend URLs (comma-separated, for CORS)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Email Notifications (Optional)
# SENDER_EMAIL=your_gmail@gmail.com
# SENDER_PASSWORD=your_app_password
