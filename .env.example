# ==============================================================================
# TalentFlow AI — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real .env files containing production secrets to version control.
# ==============================================================================

# --- Server Environment ---
FLASK_ENV=development
PORT=5000
FLASK_SECRET_KEY=change_to_a_cryptographically_secure_random_string_32_bytes_min

# --- Authentication & JWT ---
# Used for signing short-lived access tokens (15-60 min)
JWT_SECRET=change_to_a_secure_jwt_access_secret_in_production
# Used for signing long-lived refresh tokens (7 days)
JWT_REFRESH_SECRET=change_to_a_secure_jwt_refresh_secret_in_production
# Admin endpoint protection header key
ADMIN_SECRET=optional_admin_secret_for_privileged_maintenance_endpoints

# --- Database Configuration ---
# Development (PostgreSQL via Docker or local SQLite)
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/talentflow
# Example Render PostgreSQL: postgresql://user:pass@dpg-xxxx.render.com/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis & Async Workers ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- AI & HuggingFace Inference ---
# Required for 768D MPNet embedding generation and Mistral-7B LLM synthesis
HF_TOKEN=your_huggingface_api_token_here
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_CACHE_MAX=500

# --- Storage Configuration ---
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=15
# Optional S3-compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# S3_BUCKET=talentflow-resumes
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
# S3_REGION=us-east-1

# --- Email Notifications (SMTP / Gmail) ---
EMAIL_PROVIDER=smtp
SENDER_EMAIL=your_company_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true

# --- Frontend & CORS ---
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://ats917.vercel.app

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_AI=30 per minute
