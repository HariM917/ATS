# ==============================================================================
# TalentFlow AI — .gitignore
# ==============================================================================

# --- Security / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Editor / IDE Internal Files ---
.antigravity/
.vscode/
.idea/
*.swp
*.swo

# --- Python & Flask Backend ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Local Databases & Runtime Logs ---
*.db
*.sqlite
*.sqlite3
*.log
*.log.*
backend/*.log
backend/*.db
rag_observability.log

# --- Project Specific Runtime Data (Preserved locally, never committed) ---
uploads/
backend/uploads/
*.zip
cache/
.cache/

# --- Node.js & React Frontend ---
node_modules/
frontend/node_modules/
*/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.npm
/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db