# ==============================================================================
# TalentFlow AI — .gitignore
# ==============================================================================

# --- Security / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Editor / IDE Internal Files ---
.antigravity/
.vscode/
.idea/
*.swp
*.swo

# --- Python & Flask Backend ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Local Databases & Runtime Logs ---
*.db
*.sqlite
*.sqlite3
*.log
*.log.*
backend/*.log
backend/*.db
rag_observability.log

# --- Dataset Files (targeted, not blanket *.csv) ---
# Raw and processed datasets must never be committed (use Git LFS for large files)
data/raw/*
data/processed/*
data/reports/*
# Allow .gitkeep placeholders in dataset directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/evaluation/.gitkeep
!data/reports/.gitkeep
# Allow official frozen V19-V23 scientific benchmark & audit reports
!data/reports/v19_*
!data/reports/v20_*
!data/reports/v21_*
!data/reports/v22_*
!data/reports/v23_*
# data/evaluation/ is intentionally trackable (hand-curated reference pairs)
# Allow production occupational model bundle (5.97 MB)
!data/processed/models/
data/processed/models/*
!data/processed/models/v21_production_bundle.joblib

# --- Legacy Training Artifacts (backend/) ---
# These large binary files are kept locally but must not be committed
backend/archive*.zip
backend/*.pkl
backend/resumes.jsonl
backend/job_dataset.csv
# Generic rules for any future model artifacts
*.pkl
*.zip

# --- Dataset source files that are training-only ---
*.jsonl

# --- Node.js & React Frontend ---
node_modules/
frontend/node_modules/
*/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.npm
/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Runtime Upload Directory ---
uploads/
backend/uploads/

# --- Cache ---
cache/
.cache/